// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ORGANIZER
  ADMIN
}

enum ListCategory {
  NONE
  THEATER
  SPORTS
  ACADEMY
  CONCERNT
  TRAVEL
}

enum TicketType {
  REGULAR
  VIP
  VVIP
}

enum DiscountStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
}

enum TransactionStatus {
  SUCCESS
  PENDING
  FAILED
}

model User {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String   @unique
  username    String   @unique
  password    String
  referalCode String   @unique
  phoneNumber String?  @unique
  role        Role     @default(CUSTOMER)
  createdAt   DateTime @default(now())

  Event        Event[]
  Ticket       Ticket[]
  Transaction  Transaction[]
  Review       Review[]
  ReferralCode ReferralCode?
  Point        Point[]
  UserImage    UserImage[]
}

model Point {
  id        String   @id @default(uuid())
  amount    Int
  userId    String
  expiredAt DateTime
  createAt  DateTime @default(now())

  User User @relation(fields: [userId], references: [id])
}

model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  User User @relation(fields: [userId], references: [id])
}

model Event {
  id          String        @id @default(uuid())
  userId      String
  title       String
  description String
  location    String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime      @default(now())
  category    ListCategory  @default(NONE)
  Transaction Transaction[]
  Review      Review[]
  EventImage  EventImage[]
  Ticket      Ticket[]

  User     User       @relation(fields: [userId], references: [id])
  Voucher  Voucher[]
  Discount Discount[]
}

model EventImage {
  id             String   @id @default(uuid())
  eventId        String
  imagePreviewId String?
  imageContentId String?
  createdAt      DateTime @default(now())

  Event        Event  @relation(fields: [eventId], references: [id])
  ImagePreview Image? @relation("ImagePreview", fields: [imagePreviewId], references: [id])
  ImageContent Image? @relation("ImageContent", fields: [imageContentId], references: [id])
}

model UserImage {
  id       String   @id @default(uuid())
  userId   String
  url      String
  createAt DateTime @default(now())

  User User @relation(fields: [userId], references: [id])
}

model Image {
  id        String   @id @default(uuid())
  url       String
  createdAt DateTime @default(now())

  ImagePreview EventImage[] @relation("ImagePreview")
  ImageContent EventImage[] @relation("ImageContent")
}

model Review {
  id          String   @id @default(uuid())
  eventId     String?
  userId      String?
  rating      Int? // Rating between 1 and 5
  description String?
  createdAt   DateTime @default(now())

  User  User?  @relation(fields: [userId], references: [id])
  Event Event? @relation(fields: [eventId], references: [id])
}

model Ticket {
  id         String     @id @default(uuid())
  eventId    String
  ticketType TicketType @default(REGULAR)
  price      Float
  seat       Int
  createdAt  DateTime   @default(now())
  update     DateTime   @updatedAt
  userId     String?

  Transaction Transaction[]
  Discount    Discount[]

  Event   Event     @relation(fields: [eventId], references: [id])
  User    User?     @relation(fields: [userId], references: [id])
  Voucher Voucher[]
}

model Voucher {
  id              String         @id @default(uuid())
  eventId         String
  ticketId        String
  description     String
  code            String?        @unique
  discountPercent Int
  maxUses         Int
  status          DiscountStatus @default(AVAILABLE)
  validUntil      DateTime

  Event       Event         @relation(fields: [eventId], references: [id])
  Transaction Transaction[]
  Ticket      Ticket?       @relation(fields: [ticketId], references: [id])
}

model Discount {
  id              String   @id @default(uuid())
  discountPercent Int
  validUntil      DateTime
  eventId         String
  ticketId        String?

  Transaction Transaction[]
  Event       Event         @relation(fields: [eventId], references: [id])
  Ticket      Ticket?       @relation(fields: [ticketId], references: [id])
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String
  eventId     String
  ticketId    String
  voucherId   String?
  discountId  String?
  status      TransactionStatus @default(PENDING)
  totalPrice  Float // in IDR
  totalTicket Int
  createdAt   DateTime          @default(now())

  User     User      @relation(fields: [userId], references: [id])
  Event    Event     @relation(fields: [eventId], references: [id])
  Ticket   Ticket    @relation(fields: [ticketId], references: [id])
  Voucher  Voucher?  @relation(fields: [voucherId], references: [id])
  Discount Discount? @relation(fields: [discountId], references: [id])
}
